pipeline {
    agent { label 'electronix' }

    environment {
        ECR_REPO      = "387385940921.dkr.ecr.us-east-1.amazonaws.com/electronix-ecr"
        AWS_REGION    = "us-east-1"
        PRODUCTION_IP = "107.23.180.19"
    }

    stages {

        stage('Build Docker Image') {
            steps {
                dir('backend') {
                    sh '''
                    sudo docker build -t electronix-backend:${BUILD_NUMBER} .
                    '''
                }
            }
        }

        stage('Login to Amazon ECR') {
            steps {
                sh '''
                aws ecr get-login-password --region ${AWS_REGION} | \
                sudo docker login --username AWS --password-stdin ${ECR_REPO}
                '''
            }
        }

        stage('Tag & Push Image') {
            steps {
                sh '''
                sudo docker tag electronix-backend:${BUILD_NUMBER} ${ECR_REPO}:${BUILD_NUMBER}
                sudo docker tag electronix-backend:${BUILD_NUMBER} ${ECR_REPO}:latest

                sudo docker push ${ECR_REPO}:${BUILD_NUMBER}
                sudo docker push ${ECR_REPO}:latest

                echo "Image pushed successfully"
                '''
            }
        }

        stage('Deploy to Production') {
            steps {
                sshagent(['prod-server-ssh-key']) {

                    sh """
                    ssh -o StrictHostKeyChecking=no ubuntu@${PRODUCTION_IP} '

                    set -e

                    aws ecr get-login-password --region ${AWS_REGION} | \
                    sudo docker login --username AWS --password-stdin ${ECR_REPO}

                    sudo docker pull ${ECR_REPO}:latest

                    sudo docker stop electronix-backend || true
                    sudo docker rm electronix-backend || true

                    sudo docker image prune -f

                    sudo docker run -d \
                        --name electronix-backend \
                        --restart unless-stopped \
                        --env-file /home/ubuntu/.env \
                        -p 5000:5000 \
                        ${ECR_REPO}:latest

                    '
                    """
                }
            }
        }

        stage('Health Check') {
            steps {
                sshagent(['prod-server-ssh-key']) {

                    sh """
                    ssh -o StrictHostKeyChecking=no ubuntu@${PRODUCTION_IP} '

                    echo "Waiting for application..."

                    for i in {1..12}
                    do

                        STATUS=\$(curl -s -o /dev/null -w "%{http_code}" http://localhost:5000/api/health || true)

                        if [ "\$STATUS" = "200" ]
                        then
                            echo "Application is Healthy"
                            exit 0
                        fi

                        sleep 5

                    done

                    echo "Health Check Failed"

                    sudo docker logs electronix-backend

                    exit 1

                    '
                    """
                }
            }
        }

    }

    post {

        success {
            echo 'Deployment Successful'
        }

        failure {
            echo 'Deployment Failed'
        }

        always {
            cleanWs()
        }
    }
}