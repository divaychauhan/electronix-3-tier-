pipeline {
    agent {
        label 'electronix'
    }

    environment {
        AWS_REGION   = 'us-east-1'
        ECR_REGISTRY = '387385940921.dkr.ecr.us-east-1.amazonaws.com'
        ECR_REPO     = '387385940921.dkr.ecr.us-east-1.amazonaws.com/electronix-ecr'
        PRODUCTION_IP = '107.23.180.19'
    }

    stages {

        stage("Backend Pipeline") {

            // when {
            //     changeset "backend/**"
            // }

            stages {

                stage("Build Docker Image") {
                    steps {
                        dir("backend") {
                            sh '''
                               sudo docker build -t electronix-backend:${BUILD_NUMBER} .
                            '''
                        }
                    }
                }

                stage("TEST ECR Login") {
                    steps {
                        sh '''
                            aws ecr get-login-password --region ${AWS_REGION} | \
                            docker login --username AWS --password-stdin ${ECR_REGISTRY}
                        '''
                    }
                }

                stage("Tag and Push to ECR") {
                    steps {
                        sh '''
                           sudo docker tag electronix-backend:${BUILD_NUMBER} ${ECR_REPO}:${BUILD_NUMBER}
                           sudo docker tag electronix-backend:${BUILD_NUMBER} ${ECR_REPO}:latest

                           sudo docker push ${ECR_REPO}:${BUILD_NUMBER}
                           sudo docker push ${ECR_REPO}:latest

                            echo "Pushed Successfully"
                        '''
                    }
                }

            }
        }
    }

    post {
        success {
            echo '✅ Successfully logged in to Amazon ECR.'
        }

        failure {
            echo '❌ Failed to log in to Amazon ECR.'
        }
    }
}