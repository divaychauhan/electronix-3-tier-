pipeline {
    agent {
        label 'electronix'
    }

    environment {
        AWS_REGION   = 'us-east-1'
        ECR_REGISTRY = '387385940921.dkr.ecr.us-east-1.amazonaws.com'
        PRODUCTION_IP='107.23.180.19'
    }

    stage("Backend Pipline"){
        // when {
        //     changeset "backend/**"
        // }
         stages {
            stage("Build Docker Image"){
                steps{
                    dir("backend"){
                        sh 'docker build -t electronix-backend:${BUILD_NUMBER} .'
                    }
                }
            }


        stage(' TEST ECR Login') {
            steps {
                sh '''
                    aws ecr get-login-password --region ${AWS_REGION} | \
                    docker login --username AWS --password-stdin ${ECR_REGISTRY}
                '''
            }
        }

        Stage ("Tag and push to ECR "){
            steps{
                sh '''
                docker tag electronix-backend:${BUILD_NUMBER} ${ECR_REPO}:${BUILD_NUMBER}
                docker tag electronix-backend:${ECR_REPO}:latest
                docker push ${ECR_REPO}:${BUILD_NUMBER}
                docker push ${ECR_REPO}:latest

                echo "pushed success"
                '''
            }
        }
    }
    }

    
    post {
        success {
            echo '✅ Successfully logged in to Amazon ECR.'
        }

        failure {
            echo '❌ Failed to log in to Amazon ECR.'
        }

    
    }
}

